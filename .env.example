# Cloud Bridge - Environment Configuration (Prototype Mode)
# Copy this file to .env 

# NOTE: This is currently set up for SIMPLE LOCAL PROTOTYPE run (no Docker required).
# For easy local development we default to SQLite.

# =============================================================================
# Application
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=RydLvWGjAy4714zB8DESZGWKlwNnRSRvNLJ9PwwBZpg=

# =============================================================================
# Database - Prototype uses SQLite (very simple)
# For full stack later you can switch to PostgreSQL
# =============================================================================
# Easy local prototype (recommended for now)
DATABASE_URL=sqlite+aiosqlite:///./cloudbridge.db

# Full PostgreSQL (when using Docker or real Postgres)
# DATABASE_URL=postgresql+asyncpg://cloudbridge:cloudbridge_dev_password@localhost:5432/cloudbridge

# =============================================================================
# Redis (Celery broker + result backend + cache)
# =============================================================================
# Redis / Celery — not required for local-only runs (tasks execute in-process via task_always_eager).
# Set APP_ENV=development (default) to enable eager mode. No Redis process needed.
REDIS_URL=redis://:password@redis.himalay-testing.svc.cluster.local:6379/0
CELERY_BROKER_URL=redis://:password@redis.himalay-testing.svc.cluster.local:6379/0
CELERY_RESULT_BACKEND=redis://:password@redis.himalay-testing.svc.cluster.local:6379/1

# =============================================================================
# MinIO (S3-compatible artifact storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_BUCKET=cloudbridge-artifacts
# Used by the S3ArtifactStore adapter
AWS_ACCESS_KEY_ID=<your-minio-access-key>
AWS_SECRET_ACCESS_KEY=<your-minio-secret-key>
AWS_ENDPOINT_URL=https://minio.minio-tenant.svc.cluster.local
AWS_REGION=us-east-1
# Set to false for self-signed certs (cluster MinIO)
AWS_VERIFY_SSL=false

# =============================================================================
# Backend
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_KEY=DSkaIHmtV7Dq3JFN6RcqpyCZP6RXN9oJsvvRmLCGyaI
# Comma-separated list of allowed CORS origins (for local dev)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:5173", "https://orgfarm-a8dcfad9ff-dev-ed.develop.lightning.force.com", "https://orgfarm-a8dcfad9ff-dev-ed.develop.my.salesforce.com","https://cloud-bridge-himalay-testing.bobathon-us-south-1-bx2-1-eed9cf6127dd1cc2309a78aba5f4061d-0000.us-south.containers.appdomain.cloud","https://cloud-bridge-frontend-himalay-testing.bobathon-us-south-1-bx2-1-eed9cf6127dd1cc2309a78aba5f4061d-0000.us-south.containers.appdomain.cloud"]

# =============================================================================
# Frontend
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BACKEND_API_KEY=DSkaIHmtV7Dq3JFN6RcqpyCZP6RXN9oJsvvRmLCGyaI

# =============================================================================
# Security (JWT Authentication)
# =============================================================================
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=DSkaIHmtV7Dq3JFN6RcqpyCZP6RXN9oJsvvRmLCGyaI
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Optional: Salesforce (will be used from PR 3 onward)
# =============================================================================
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
# SF_REDIRECT_URI=http://localhost:8000/api/v1/orgs/callback

LLM_API_KEY=b8f5fc96813c04c2aa58996079686557
LLM_ENDPOINT_URL=https://llm-crinsight-route-salesforce-crinsight.ae-sfamo-cluster-dev-2322d3421b77f2abeee72f9925acd471-0000.us-south.containers.appdomain.cloud/v1/ica-llm  # or your custom endpoint
LLM_MODEL=389  # or your chosen model
