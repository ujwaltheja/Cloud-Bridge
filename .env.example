# Cloud Bridge - Environment Configuration (Prototype Mode)
# Copy this file to .env 

# NOTE: This is currently set up for SIMPLE LOCAL PROTOTYPE run (no Docker required).
# For easy local development we default to SQLite.

# =============================================================================
# Application
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme-generate-a-real-32-byte-base64-key

# =============================================================================
# Database - Prototype uses SQLite (very simple)
# For full stack later you can switch to PostgreSQL
# =============================================================================
# Easy local prototype (recommended for now)
DATABASE_URL=sqlite+aiosqlite:///./cloudbridge.db

# Full PostgreSQL (when using Docker or real Postgres)
# DATABASE_URL=postgresql+asyncpg://cloudbridge:cloudbridge_dev_password@localhost:5432/cloudbridge

# =============================================================================
# Redis (Celery broker + result backend + cache)
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# MinIO (S3-compatible artifact storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
ARTIFACT_STORE_BACKEND=local
LOCAL_ARTIFACT_PATH=./artifacts
MINIO_BUCKET=cloudbridge-artifacts
# Used by the S3ArtifactStore adapter
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_dev_password
AWS_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1

# =============================================================================
# Backend
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins (for local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Frontend
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# Security (for future use)
# =============================================================================
# JWT_SECRET_KEY=changeme-generate-strong-secret
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Optional: Salesforce (will be used from PR 3 onward)
# =============================================================================
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
# SF_REDIRECT_URI=http://localhost:8000/api/v1/orgs/callback
